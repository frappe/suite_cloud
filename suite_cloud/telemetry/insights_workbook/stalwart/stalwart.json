{
 "charts": {
  "stalwart-active-connections": {
   "chart_type": "Line",
   "config": {
    "filters": {
     "filters": [
      {
       "column": {
        "column_name": "metric",
        "type": "column"
       },
       "operator": "=",
       "value": "smtp.active-connections"
      }
     ],
     "logical_operator": "And"
    },
    "limit": 100,
    "order_by": [
     {
      "column": {
       "column_name": "timestamp",
       "type": "column"
      },
      "direction": "asc"
     }
    ],
    "split_by": {
     "dimension": {
      "column_name": "hostname",
      "data_type": "String",
      "dimension_name": "hostname"
     },
     "max_split_values": 10
    },
    "x_axis": {
     "dimension": {
      "column_name": "timestamp",
      "data_type": "Datetime",
      "dimension_name": "timestamp",
      "granularity": "day"
     }
    },
    "y_axis": {
     "series": [
      {
       "measure": {
        "data_type": "Decimal",
        "expression": {
         "expression": "avg(value)",
         "type": "expression"
        },
        "measure_name": "Connections"
       }
      }
