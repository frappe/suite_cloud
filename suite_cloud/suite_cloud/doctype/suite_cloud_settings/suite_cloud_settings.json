 "fields": [
  {
   "fieldname": "dns_tab",
   "fieldtype": "Tab Break",
   "label": "DNS"
  },
  {
   "fieldname": "section_break_hrww",
   "fieldtype": "Section Break"
  },
  {
   "description": "Clusters, nodes and egress gateways get their DNS records under this domain.",
   "fieldname": "root_domain_name",
   "fieldtype": "Data",
   "in_list_view": 1,
   "label": "Root Domain Name",
   "mandatory_depends_on": "eval: doc.dns_provider",
   "placeholder": "frappemail.com"
  },
  {
   "fieldname": "column_break_4ccc",
   "fieldtype": "Column Break"
  },
  {
   "default": "300",
   "description": "Used for records Suite Cloud writes and suggested to sites for theirs.",
   "fieldname": "default_dns_ttl",
   "fieldtype": "Int",
   "label": "Default DNS TTL",
   "reqd": 1
  },
  {
   "fieldname": "dns_provider_section",
   "fieldtype": "Section Break",
   "label": "DNS Provider"
  },
  {
   "description": "The service provider managing your root domain's DNS records. The same credentials are handed to Stalwart for ACME DNS-01 challenges.",
   "fieldname": "dns_provider",
   "fieldtype": "Select",
   "label": "DNS Provider",
   "options": "\nAmazonRoute53\nDigitalOcean\nCloudflare\nHetzner\nLinode\nNamecheap\nGoDaddy"
  },
  {
   "fieldname": "column_break_pntn",
   "fieldtype": "Column Break"
  },
  {
   "depends_on": "eval: doc.dns_provider && [\"AmazonRoute53\", \"Cloudflare\"].includes(doc.dns_provider)",
   "description": "Unique identifier for your DNS zone.",
   "fieldname": "dns_provider_zone_id",
   "fieldtype": "Data",
   "label": "Zone ID"
  },
  {
   "depends_on": "eval: doc.dns_provider && [\"AmazonRoute53\"].includes(doc.dns_provider)",
   "description": "Public key used to authenticate API requests.",
   "fieldname": "dns_provider_access_key",
   "fieldtype": "Data",
   "label": "Access Key",
   "mandatory_depends_on": "eval: doc.dns_provider && [\"AmazonRoute53\"].includes(doc.dns_provider)"
  },
  {
   "depends_on": "eval: doc.dns_provider && [\"AmazonRoute53\"].includes(doc.dns_provider)",
   "description": "Secret key paired with the access key for authentication.",
   "fieldname": "dns_provider_access_secret",
   "fieldtype": "Password",
   "label": "Access Secret",
   "mandatory_depends_on": "eval: doc.dns_provider && [\"AmazonRoute53\"].includes(doc.dns_provider)"
  },
  {
   "depends_on": "eval: doc.dns_provider && [\"GoDaddy\"].includes(doc.dns_provider)",
   "description": "Key used for authorization with the DNS provider.",
   "fieldname": "dns_provider_key",
   "fieldtype": "Data",
   "label": "Key",
   "mandatory_depends_on": "eval: doc.dns_provider && [\"GoDaddy\"].includes(doc.dns_provider)"
  },
  {
   "depends_on": "eval: doc.dns_provider && [\"GoDaddy\"].includes(doc.dns_provider)",
   "description": "Secret used along with the auth key for secure access.",
   "fieldname": "dns_provider_secret",
   "fieldtype": "Password",
   "label": "Secret",
   "mandatory_depends_on": "eval: doc.dns_provider && [\"GoDaddy\"].includes(doc.dns_provider)"
  },
  {
   "depends_on": "eval: doc.dns_provider && [\"Cloudflare\", \"Namecheap\"].includes(doc.dns_provider)",
   "description": "Account username for the DNS provider.",
   "fieldname": "dns_provider_username",
   "fieldtype": "Data",
   "label": "Username",
   "mandatory_depends_on": "eval: doc.dns_provider && [\"Namecheap\"].includes(doc.dns_provider)"
  },
  {
   "depends_on": "eval: doc.dns_provider && [\"Namecheap\"].includes(doc.dns_provider)",
   "description": "IP address whitelisted to make API calls.",
   "fieldname": "dns_provider_client_ip",
   "fieldtype": "Data",
   "label": "Client IP",
   "mandatory_depends_on": "eval: doc.dns_provider && [\"Namecheap\"].includes(doc.dns_provider)"
  },
  {
   "depends_on": "eval: doc.dns_provider && [\"DigitalOcean\", \"Cloudflare\", \"Hetzner\", \"Linode\", \"Namecheap\"].includes(doc.dns_provider)",
   "description": "The token used to authenticate with your DNS provider.",
   "fieldname": "dns_provider_token",
   "fieldtype": "Password",
   "label": "Token",
   "mandatory_depends_on": "eval: doc.dns_provider && [\"DigitalOcean\", \"Cloudflare\", \"Hetzner\", \"Linode\", \"Namecheap\"].includes(doc.dns_provider)"
  },
  {
   "default": "0",
   "depends_on": "eval: doc.dns_provider && [\"AmazonRoute53\"].includes(doc.dns_provider)",
   "description": "Indicates whether the DNS zone is private.",
   "fieldname": "dns_provider_private_zone",
   "fieldtype": "Check",
   "label": "Private Zone"
  },
  {
   "fieldname": "stalwart_tab",
   "fieldtype": "Tab Break",
   "label": "Stalwart"
  },
  {
   "fieldname": "versions_section",
   "fieldtype": "Section Break",
   "label": "Versions"
  },
  {
   "default": "v0.16.20",
   "description": "Default version new clusters pin. Upgrades are per cluster.",
   "fieldname": "stalwart_version",
   "fieldtype": "Data",
   "label": "Stalwart Version",
   "reqd": 1
  },
  {
   "default": "https://github.com/stalwartlabs/stalwart/releases/download/{version}/stalwart-{target}.tar.gz",
   "description": "{version} and {target} (e.g. x86_64-unknown-linux-gnu) are substituted on the node.",
   "fieldname": "stalwart_download_url_template",
   "fieldtype": "Data",
   "label": "Stalwart Download URL Template",
   "length": 255,
   "reqd": 1
  },
  {
   "fieldname": "column_break_stalwart",
   "fieldtype": "Column Break"
  },
  {
   "default": "v1.0.12",
   "fieldname": "stalwart_cli_version",
   "fieldtype": "Data",
   "label": "Stalwart CLI Version",
   "reqd": 1
  },
  {
   "default": "https://github.com/stalwartlabs/cli/releases/download/{version}/stalwart-cli-{target}.tar.xz",
   "fieldname": "stalwart_cli_download_url_template",
   "fieldtype": "Data",
   "label": "Stalwart CLI Download URL Template",
   "length": 255,
   "reqd": 1
  },
  {
   "fieldname": "acme_section",
   "fieldtype": "Section Break",
   "label": "TLS Certificates (ACME)"
  },
  {
   "default": "https://acme-v02.api.letsencrypt.org/directory",
   "description": "Use https://acme-staging-v02.api.letsencrypt.org/directory while testing.",
   "fieldname": "acme_directory_url",
   "fieldtype": "Data",
   "label": "ACME Directory URL",
   "length": 255,
   "reqd": 1
  },
  {
   "fieldname": "column_break_acme",
   "fieldtype": "Column Break"
  },
  {
   "description": "Certificate expiry notices from the CA go here.",
   "fieldname": "acme_contact_email",
   "fieldtype": "Data",
   "label": "ACME Contact Email",
   "options": "Email"
  },
  {
   "fieldname": "suite_cloud_tab",
   "fieldtype": "Tab Break",
   "label": "Suite Cloud"
  },
  {
   "description": "URL handed to Frappe Cloud for sites to reach this Suite Cloud. Defaults to this site's URL.",
   "fieldname": "public_url",
   "fieldtype": "Data",
   "label": "Public URL",
   "options": "URL"
  },
  {
   "fieldname": "column_break_suite_cloud",
   "fieldtype": "Column Break"
  },
  {
   "description": "Every Suite Site API request runs as this user. Created on install.",
   "fieldname": "site_service_user",
   "fieldtype": "Link",
   "label": "Site Service User",
   "options": "User",
   "read_only": 1
  },
  {
   "fieldname": "timeouts_section",
   "fieldtype": "Section Break",
   "label": "Timeouts (Seconds)"
  },
  {
   "default": "1800",
   "fieldname": "server_job_timeout",
   "fieldtype": "Int",
   "label": "Server Job Timeout",
   "reqd": 1
  }
 ],
