   "fieldtype": "Check",
   "label": "Include Source",
   "description": "Store the full message text too. Uses much more disk. Needed only for highlighting."
  },
  {
   "default": "0.5",
   "depends_on": "eval: doc.type == \"Meilisearch\"",
   "description": "Seconds between Meilisearch task checks.",
   "fieldname": "poll_interval",
   "fieldtype": "Float",
   "label": "Poll Interval"
  },
  {
   "default": "1",
   "depends_on": "eval: doc.type == \"Meilisearch\"",
   "fieldname": "fail_on_timeout",
   "fieldtype": "Check",
   "label": "Fail On Timeout",
   "description": "Mark a Meilisearch task as failed when it times out."
  },
  {
   "fieldname": "column_break_search",
   "fieldtype": "Column Break"
  },
  {
   "default": "Unauthenticated",
   "fieldname": "http_auth_type",
   "fieldtype": "Select",
