 "fields": [
  {
   "fieldname": "title",
   "fieldtype": "Data",
   "in_list_view": 1,
   "label": "Title",
   "reqd": 1,
   "description": "Name shown when picking a store, e.g. Production PostgreSQL."
  },
  {
   "fieldname": "kind",
   "fieldtype": "Select",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "label": "Kind",
   "options": "Data\nBlob\nSearch\nIn-Memory",
   "reqd": 1,
   "set_only_once": 1,
   "description": "Data: settings, directory and metadata. Blob: message bodies and attachments. Search: full-text index. In-Memory: caches and rate limits."
  },
  {
   "fieldname": "column_break_kind",
   "fieldtype": "Column Break"
  },
  {
   "description": "Backend for the store. A multi-node cluster needs a PostgreSql or MySql data store and a Redis in-memory store.",
   "fieldname": "type",
   "fieldtype": "Select",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "label": "Type",
   "options": "\nDefault\nPostgreSql\nMySql\nRocksDb\nS3\nFileSystem\nElasticSearch\nMeilisearch\nRedis\nRedisCluster\nRedisSentinel",
   "reqd": 1,
   "set_only_once": 1
  },
  {
   "fieldname": "connection_section",
   "fieldtype": "Section Break",
   "label": "Connection",
   "depends_on": "eval: [\"PostgreSql\", \"MySql\", \"RedisCluster\", \"RedisSentinel\"].includes(doc.type)"
  },
  {
   "fieldname": "host",
   "fieldtype": "Data",
   "label": "Host",
   "mandatory_depends_on": "eval: [\"PostgreSql\", \"MySql\"].includes(doc.type)",
   "depends_on": "eval: [\"PostgreSql\", \"MySql\"].includes(doc.type)"
  },
  {
   "fieldname": "port",
   "fieldtype": "Int",
   "label": "Port",
   "description": "Blank uses the default: 5432 for PostgreSQL, 3306 for MySQL.",
   "depends_on": "eval: [\"PostgreSql\", \"MySql\"].includes(doc.type)"
  },
  {
   "default": "stalwart",
   "fieldname": "database",
   "fieldtype": "Data",
   "label": "Database",
   "description": "Must exist. Stalwart creates the tables.",
   "depends_on": "eval: [\"PostgreSql\", \"MySql\"].includes(doc.type)"
  },
  {
   "fieldname": "column_break_conn",
   "fieldtype": "Column Break"
  },
  {
   "default": "stalwart",
   "fieldname": "auth_username",
   "fieldtype": "Data",
   "label": "Username",
   "description": "Optional for Redis Cluster and Sentinel."
  },
  {
   "fieldname": "auth_secret",
   "fieldtype": "Password",
   "label": "Password"
  },
  {
   "default": "0",
   "fieldname": "use_tls",
   "fieldtype": "Check",
   "label": "Use TLS",
   "description": "Turn on for managed databases on the internet.",
   "depends_on": "eval: [\"PostgreSql\", \"MySql\"].includes(doc.type)"
  },
  {
   "default": "fast",
   "depends_on": "eval: doc.type == \"PostgreSql\"",
   "fieldname": "pool_recycling_method",
   "fieldtype": "Select",
   "label": "Pool Recycling Method",
   "options": "fast\nverified\nclean",
   "description": "Check before a connection is reused. fast: none. verified: ping. clean: ping and reset."
  },
  {
   "default": "5",
   "depends_on": "eval: doc.type == \"MySql\"",
   "fieldname": "pool_min_connections",
   "fieldtype": "Int",
   "label": "Pool Min Connections",
   "description": "Idle MySQL connections to keep open."
  },
  {
   "depends_on": "eval: doc.type == \"MySql\"",
   "fieldname": "max_allowed_packet",
   "fieldtype": "Int",
   "label": "Max Allowed Packet",
   "description": "In bytes. Raise it if large messages fail to store."
  },
  {
   "depends_on": "eval: doc.type == \"PostgreSql\"",
   "description": "Extra PostgreSQL options, e.g. sslmode=require.",
   "fieldname": "options",
   "fieldtype": "Data",
   "label": "Options"
  },
  {
   "fieldname": "local_section",
   "fieldtype": "Section Break",
   "label": "Local Storage",
   "depends_on": "eval: [\"RocksDb\", \"FileSystem\"].includes(doc.type)"
  },
  {
   "default": "/var/lib/stalwart",
   "fieldname": "path",
   "fieldtype": "Data",
   "label": "Path",
   "mandatory_depends_on": "eval: [\"RocksDb\", \"FileSystem\"].includes(doc.type)",
   "description": "Folder on the node. Single-node clusters and gateways only."
  },
  {
   "default": "16834",
   "depends_on": "eval: doc.type == \"RocksDb\"",
   "fieldname": "blob_size",
   "fieldtype": "Int",
   "label": "Blob Size",
   "description": "Blobs smaller than this, in bytes, stay inline. Default 16834."
  },
  {
   "default": "134217728",
   "depends_on": "eval: doc.type == \"RocksDb\"",
   "fieldname": "buffer_size",
   "fieldtype": "Int",
   "label": "Buffer Size",
   "description": "Write buffer in bytes. Default 128 MB."
  },
  {
   "fieldname": "column_break_local",
   "fieldtype": "Column Break"
  },
  {
   "depends_on": "eval: doc.type == \"RocksDb\"",
   "fieldname": "pool_workers",
   "fieldtype": "Int",
   "label": "Pool Workers",
   "description": "Background threads. Blank lets RocksDB choose."
  },
  {
   "default": "2",
   "depends_on": "eval: doc.type == \"FileSystem\"",
   "fieldname": "depth",
   "fieldtype": "Int",
   "label": "Depth",
   "description": "Folder levels for files. 2 is enough for millions of files."
  },
  {
   "fieldname": "s3_section",
   "fieldtype": "Section Break",
   "label": "S3",
   "depends_on": "eval: [\"S3\"].includes(doc.type)"
  },
  {
   "fieldname": "region",
   "fieldtype": "Data",
   "label": "Region",
   "mandatory_depends_on": "eval: doc.type == \"S3\"",
   "description": "Bucket region, e.g. ap-south-1."
  },
  {
   "fieldname": "bucket",
   "fieldtype": "Data",
   "label": "Bucket",
   "mandatory_depends_on": "eval: doc.type == \"S3\"",
   "description": "Must exist. Stalwart does not create buckets."
  },
  {
   "description": "Blank for AWS. Set the API URL for other S3-compatible services.",
   "fieldname": "endpoint",
   "fieldtype": "Data",
   "label": "Endpoint"
  },
  {
   "fieldname": "key_prefix",
   "fieldtype": "Data",
   "label": "Key Prefix",
   "description": "Added to each object key, e.g. blr-1/. Lets clusters share a bucket."
  },
  {
   "fieldname": "column_break_s3",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "access_key",
   "fieldtype": "Data",
   "label": "Access Key",
   "description": "Needs read, write and delete access to the bucket."
  },
  {
   "fieldname": "secret_key",
   "fieldtype": "Password",
   "label": "Secret Key"
  },
  {
   "default": "1",
   "fieldname": "verify_after_write",
   "fieldtype": "Check",
   "label": "Verify After Write",
   "description": "Read each object back after writing. Doubles requests."
  },
  {
   "fieldname": "server_section",
   "fieldtype": "Section Break",
   "label": "Server",
   "depends_on": "eval: [\"ElasticSearch\", \"Meilisearch\", \"Redis\"].includes(doc.type)"
  },
  {
   "fieldname": "url",
   "fieldtype": "Data",
   "label": "URL",
   "mandatory_depends_on": "eval: [\"ElasticSearch\", \"Meilisearch\", \"Redis\"].includes(doc.type)",
   "description": "Server URL, e.g. https://search.example.com:9200, http://meili:7700 or redis://redis.example.com:6379."
  },
  {
   "fieldname": "search_section",
   "fieldtype": "Section Break",
   "label": "Search Server",
   "depends_on": "eval: [\"ElasticSearch\", \"Meilisearch\"].includes(doc.type)"
  },
  {
   "default": "0",
   "depends_on": "eval: doc.type == \"ElasticSearch\"",
   "fieldname": "num_replicas",
   "fieldtype": "Int",
   "label": "Replicas",
   "description": "Copies of each shard. 0 on a single server."
  },
  {
   "default": "3",
   "depends_on": "eval: doc.type == \"ElasticSearch\"",
   "fieldname": "num_shards",
   "fieldtype": "Int",
   "label": "Shards",
   "description": "3 suits most setups."
  },
  {
   "default": "0",
   "depends_on": "eval: doc.type == \"ElasticSearch\"",
